# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenSea API key — used by `npm run build:nfts` to fetch live NFT listings.
OPENSEA_API_KEY=

# Replicate API token — used by the generation scripts
# (build:videos / build:vibe / build:bakeoff) for image-to-video and image edits.
REPLICATE_API_TOKEN=
